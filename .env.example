# FalkorDB Connection Settings
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_PASSWORD=

# Application Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Maximum Upload Constraints (Security)
MAX_FILE_SIZE_MB=15
MAX_FILE_COUNT=500
MAX_ZIP_SIZE_MB=25

# Optional LLM Explanation (Works completely without LLM as well)
# If left empty, CodeImpact AI uses deterministic graph-query-based explanations
GEMINI_API_KEY=
LLM_MODEL=gemini-1.5-flash
